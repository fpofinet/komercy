{% extends 'base.html.twig' %}

{% block title %}Update categorie{% endblock %}

{% block body %}
<div class="container">
    <div class="col-md-6 col-sm-10 col-12 mx-auto mt-3">
        <a href="{{ path('categorie') }}" class="btn btn-secondary btn-sm mb-2">Retour à la liste</a>
        <div class="card border-0 shadow">
            <div class="card-header bg-primary p-0">
                <p class="text-center h4 text-white m-0">Modifier la categorie</p>
            </div>
            <div class="card-body">
                {{ include('categorie/form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
