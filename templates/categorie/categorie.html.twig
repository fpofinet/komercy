{% extends 'base.html.twig' %}

{% block title %}Détail de la categorie{% endblock %}

{% block body %}
    <h1>Détail de la categorie</h1>

    <table class="table">
        <tr>
            <th>Nom</th>
            <td>{{ categorie.code }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ categorie.description }}</td>
        </tr>
       
        <tr>
            <th>Créé le</th>
            <td>{{ categorie.createdAt|date('d/m/Y H:i') }}</td>
        </tr>
    </table>

    <a href="{{ path('update_categorie', {'id': categorie.id}) }}" class="btn btn-warning">Modifier</a>
    <a href="{{ path('categorie') }}" class="btn btn-secondary">Retour</a>

    {{ include('categorie/delete.html.twig', {'categorie': categorie}) }}
{% endblock %}
