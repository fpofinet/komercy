{% extends 'base.html.twig' %}

{% block title %}Détail du produit{% endblock %}

{% block body %}
    <h1>Détail du produit</h1>

    <table class="table">
        <tr>
            <th>Nom</th>
            <td>{{ categorie.code }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ categorie.description }}</td>
        </tr>
       
        <tr>
            <th>Créé le</th>
            <td>{{ categorie.createdAt|date('d/m/Y H:i') }}</td>
        </tr>
    </table>

    <a href="{{ path('app_categorie_update', {'id': categorie.id}) }}" class="btn btn-warning">Modifier</a>
    <a href="{{ path('app_categorie') }}" class="btn btn-secondary">Retour</a>

    {{ include('categorie/delete.html.twig', {'categorie': categorie}) }}
{% endblock %}
