{% extends 'base.html.twig' %}

{% block title %}Détail du produit{% endblock %}

{% block body %}
    <h1>Détail du produit</h1>

    <table class="table">
        <tr>
            <th>Nom</th>
            <td>{{ product.code }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ product.description }}</td>
        </tr>
       
        <tr>
            <th>Créé le</th>
            <td>{{ product.createdAt|date('d/m/Y H:i') }}</td>
        </tr>
    </table>

    <a href="{{ path('update_product', {'id': product.id}) }}" class="btn btn-warning">Modifier</a>
    <a href="{{ path('product') }}" class="btn btn-secondary">Retour</a>

    {{ include('product/delete.html.twig', {'product': product}) }}
{% endblock %}