{% extends 'base.html.twig' %}

{% block title %}Liste des products{% endblock %}

{% block body %}
<div class="">
    <p class="text-center h4 fw-bold mt-md-3">Liste des produits</p>
    <a href="{{ path('add_product') }}" class="btn bg-primary text-white btn-sm mb-3">Ajouter</a>
    <div class="table-responsive shadow p-3">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Quantite</th>
                    <th>Date de création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.code }}</td>
                    <td>{{ product.description|u.truncate(50) }}</td>
                    <td>{{ product.price }}</td>
                    <td>{{ product.quantity }}</td>
                    <td>{{ product.createdAt|date('d-m-Y H:i') }}</td>
                    <td>
                        <a href="{{ path('show_product', {'id': product.id}) }}" class="btn btn-sm btn-info">Voir</a>
                        <a href="{{ path('update_product', {'id': product.id}) }}" class="btn btn-sm btn-warning">Modifier</a>

                        {{ include('product/delete.html.twig', {'product': product}) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun product trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}


