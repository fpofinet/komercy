{% extends 'base.html.twig' %}

{% block title %}Liste des products{% endblock %}

{% block body %}
    <h1>Liste des products</h1>

    <a href="{{ path('app_product_add') }}" class="btn btn-primary mb-3">Créer un nouveau product</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Quantite</th>
                <th>Date de création</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.code }}</td>
                <td>{{ product.description|u.truncate(50) }}</td>
                <td>{{ product.price }}</td>
                <td>{{ product.quantity }}</td>
                <td>{{ product.createdAt|date('d-m-Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_product_update', {'id': product.id}) }}" class="btn btn-sm btn-warning">Modifier</a>

                    {{ include('product/delete.html.twig', {'product': product}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun product trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}


