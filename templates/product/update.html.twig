{% extends 'base.html.twig' %}

{% block title %}Update product{% endblock %}

{% block body %}
<div class="mb-5">
    <div class="container mt-3">
        <div class="col-md-6 col-sm-10 mx-auto">
            <a href="{{ path('product') }}" class="btn btn-secondary btn-sm mb-2">Retour à la liste</a>
            <div class="card border-0 shadow">
                <div class="card-header p-0  bg-primary">
                    <p class="text-center m-0 text-white h4 fw-bold mt-md-3">Retour à la liste</p>
                </div>
                <div class="card-body">
                    {{ include('product/form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}